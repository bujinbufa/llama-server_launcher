<Window x:Class="LlamaManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LlamaManager.Views.Controls"
        Title="Llama🚀"

        Width="400"
        SizeToContent="Height"
        FontSize="16"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Border BorderThickness="1" BorderBrush="Gray">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Llama🚀" FontSize="20" FontWeight="Bold" VerticalAlignment="top" Margin="12,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="top">
                    <Button Width="25" Height="25" Content="—" Click="MinimizeButton_Click"/>
                    <Button Width="25" Height="25" Content="↓" Click="TrayButton_Click"/>
                    <Button Width="25" Height="25" Content="×" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- 主界面 -->
            <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.ColumnSpan="2" Header="当前状态">
                        <StackPanel Margin="17">
                            <TextBlock Text="模型"/>
                            <TextBlock x:Name="CurrentModelText" Text="未启动" FontSize="15" Margin="0,5,0,10"/>

                            <TextBlock Text="状态"/>
                            <!-- 拆分为图标和文字，方便单独控制图标闪烁 -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="StatusIcon" Text="☯" FontSize="20" Margin="0,5,0,0"/>
                                <TextBlock x:Name="StatusText" Text="已停止" FontSize="15" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- 显存监视：每 5 秒刷新；无 NVIDIA GPU 时显示提示 -->
                            <TextBlock x:Name="GpuMemText" Text="显存：检测中…" FontSize="13" Foreground="Gray" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <Button x:Name="LogButton" Grid.Column="1" Content="日志" VerticalAlignment="Top"
                            Height="24" Padding="10,0" Margin="0,4,10,0" Click="ToggleLogPanel_Click"/>
                    <!-- 测试对话：验证当前服务与参数效果，支持请求级采样参数覆盖 -->
                    <Button Grid.Column="1" Content="测试" VerticalAlignment="Top" HorizontalAlignment="Right"
                            Height="24" Padding="10,0" Margin="0,32,10,0" Click="ChatTestButton_Click"/>
                </Grid>

                <GroupBox Header="API连接" Margin="0,15,0,0">
                    <StackPanel Margin="17">
                        <TextBlock x:Name="ApiText" Text="未启动" FontSize="15" ToolTip="{Binding Text, RelativeSource={RelativeSource self}}"/>
                        <Button Content="复制" Width="70" HorizontalAlignment="Left" Margin="0,8,0,0" Click="CopyApiButton_Click"/>
                        <!-- 参数锁定：第三方客户端接代理地址，强制使用本工具启动配置的采样参数；单行布局避免撜高主界面 -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="LockButton" Content="参数锁定：关" Height="24" Padding="8,0" Click="LockButton_Click"
                                    ToolTip="开启后，第三方客户端（VSCode、Hermes 等）改连右侧代理地址，它们自带的采样参数会被剥掉，强制使用本工具启动配置"/>
                            <TextBox x:Name="LockUrlBox" IsReadOnly="True" Height="24" Width="150" Margin="8,0,0,0" Visibility="Collapsed"
                                     ToolTip="锁定代理地址：第三方客户端改连这里即可；点击可选中复制"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>


                <Border BorderBrush="Gray" BorderThickness="1" Margin="0,15,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 标题行：左侧文字，右侧按钮 -->
                        <Grid Grid.Row="0" Margin="5,3,5,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="选择模型" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="生成配置" Height="22" Padding="0,0" Click="GenerateConfigButton_Click"/>
                        </Grid>

                        <!-- 分隔线（可选） -->
                        <!-- <Rectangle Grid.Row="0" Height="1" Fill="Gray" VerticalAlignment="Bottom" Margin="5,0,5,0"/> -->

                        <!-- 下拉框 -->
                        <ComboBox Grid.Row="1"
                                x:Name="ModelComboBox"
                                Height="32"
                                Margin="10,5,10,10"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                DropDownOpened="ModelComboBox_DropDownOpened"
                                HorizontalContentAlignment="Stretch">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>


                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="✎"
                                                    Width="20"
                                                    Height="20"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    FontSize="12"
                                                    Cursor="Hand"
                                                    Click="EditModelButton_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="编辑"/>
                                            <Button Content="✕"
                                                    Width="20"
                                                    Height="20"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    FontSize="12"
                                                    Cursor="Hand"
                                                    Click="DeleteModelButton_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="删除"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                    <Button x:Name="StartButton" Content="启动" Width="90" Height="35" Click="StartButton_Click"/>
                    <Button x:Name="StopButton" Content="停止" Width="90" Height="35" Margin="15,0,0,0" Click="StopButton_Click"/>
                    <Button x:Name="RestartButton" Content="重启" Width="90" Height="35" Margin="15,0,0,0" Click="RestartButton_Click"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <!-- 日志面板 -->
            <Border x:Name="LogPanel" Grid.Row="1" Grid.Column="1" Width="430"
                    Background="#1E1E1E" CornerRadius="4" Padding="10"
                    Margin="0,5,5,5" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 实时/历史切换：默认“● 实时”只看当前输出，历史文件选中哪个看哪个 -->
                        <!-- 深色自定义模板：默认主题下直接设色不生效，白字深色底清晰可读 -->
                        <ComboBox x:Name="LogSelect" Height="26" FontSize="13" Foreground="#FFFFFF"
                                  SelectionChanged="LogSelect_SelectionChanged">
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False" ClickMode="Press">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="bd" Background="#3C3C3C" BorderBrush="#666666" BorderThickness="1" CornerRadius="3">
                                                        <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#0078D7"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter Margin="8,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          IsHitTestVisible="False"/>
                                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
                                            <Border Background="#3C3C3C" BorderBrush="#666666" BorderThickness="1"
                                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsPresenter/>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </ComboBox.Template>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="#E8E8E8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="ibd" Background="Transparent" Padding="8,4">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter TargetName="ibd" Property="Background" Value="#094771"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ibd" Property="Background" Value="#0078D7"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <!-- 外观设置：文字/背景颜色、字号、行距，与命令行预览共用同一份设置 -->
                        <Button x:Name="LogAppearanceButton" Grid.Column="1" Content="🎨" Width="26" Height="22" FontSize="12"
                                Margin="5,0,0,0" Click="LogAppearanceButton_Click" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" ToolTip="调整文字颜色/字号/行距"/>
                        <Popup x:Name="LogAppearancePopup" PlacementTarget="{Binding ElementName=LogAppearanceButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <controls:AppearancePanel/>
                        </Popup>
                        <Button Grid.Column="2" Content="×" Width="22" Height="22" FontSize="14" Margin="5,0,0,0"
                                Click="CloseLogPanel_Click" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"/>
                    </Grid>
                    <!-- RichTextBox：支持逐行着色（error红/warn黄/关键行亮色），其余行为与原 TextBox 一致 -->
                    <RichTextBox x:Name="LogPreview" Grid.Row="1" IsReadOnly="True" Height="500"
                             Background="#2D2D2D" Foreground="#00FF41" FontFamily="Consolas" FontSize="14" Block.LineHeight="22"
                             Padding="4" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>


