<UserControl x:Class="LlamaManager.Views.Controls.AppearancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13">
    <Border Background="#2B2B2B" BorderBrush="#555555" BorderThickness="1" CornerRadius="4" Padding="10">
        <StackPanel Width="230">
            <TextBlock Text="输出外观设置" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

            <TextBlock Text="文字颜色" Foreground="#CCCCCC" Margin="0,2,0,4"/>
            <WrapPanel x:Name="TextSwatches"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBox x:Name="TextHexBox" Width="80" Height="24" FontSize="12" KeyDown="TextHexBox_KeyDown"/>
                <Border Width="42" Height="24" Margin="6,0,0,0" BorderBrush="#666666" BorderThickness="1" CornerRadius="2">
                    <Rectangle x:Name="TextPreview"/>
                </Border>
                <TextBlock Text="自定义(回车)" Foreground="#888888" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <TextBlock Text="背景颜色" Foreground="#CCCCCC" Margin="0,10,0,4"/>
            <WrapPanel x:Name="BgSwatches"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBox x:Name="BgHexBox" Width="80" Height="24" FontSize="12" KeyDown="BgHexBox_KeyDown"/>
                <Border Width="42" Height="24" Margin="6,0,0,0" BorderBrush="#666666" BorderThickness="1" CornerRadius="2">
                    <Rectangle x:Name="BgPreview"/>
                </Border>
            </StackPanel>

            <TextBlock Text="字号" Foreground="#CCCCCC" Margin="0,10,0,0"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="24" IsSnapToTickEnabled="True" TickFrequency="1"
                        ValueChanged="FontSizeSlider_Changed" VerticalAlignment="Center"/>
                <TextBlock x:Name="FontSizeText" Grid.Column="1" Width="28" TextAlignment="Right" Foreground="#FFFFFF" Margin="6,0,0,0"/>
            </Grid>

            <TextBlock Text="行距" Foreground="#CCCCCC" Margin="0,6,0,0"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="LineHeightSlider" Minimum="16" Maximum="40" IsSnapToTickEnabled="True" TickFrequency="1"
                        ValueChanged="LineHeightSlider_Changed" VerticalAlignment="Center"/>
                <TextBlock x:Name="LineHeightText" Grid.Column="1" Width="28" TextAlignment="Right" Foreground="#FFFFFF" Margin="6,0,0,0"/>
            </Grid>

            <Button Content="恢复默认" Width="80" Height="24" Margin="0,10,0,0" HorizontalAlignment="Right"
                    Click="Reset_Click" ToolTip="恢复为默认的绿色终端风格"/>
        </StackPanel>
    </Border>
</UserControl>
