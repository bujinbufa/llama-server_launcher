                            </CheckBox>

                            <!-- 对话模板 -->
                            <TextBlock x:Name="ChatTemplateLabel" Margin="5,5,0,5" Visibility="Collapsed">
                                <Run Text="对话模板 --chat-template"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <TextBox x:Name="ChatTemplate" Height="28" Margin="5,0,5,8" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 调试参数子块 -->
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="3">
                    <StackPanel>
                        <Grid Background="#F0F0F0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="调试参数" FontWeight="Bold" VerticalAlignment="Center" Margin="5,5,5,5"/>
                            <Button Grid.Column="2" Content="清空" Click="ClearGroup_Click" Tag="Debug" Height="22" Padding="8,0" Margin="0,0,5,0"/>
                            <Button Grid.Column="3" Content="隐藏/显示" Click="TogglePanel_Click" Tag="DebugPanel" Margin="0,0,5,0" Height="22" Padding="5,0"/>
                            <Button Grid.Column="1" HorizontalAlignment="Right" Content="添加参数" Click="AddParamButton_Click" Tag="DebugMenu" Margin="0,0,5,0" Height="22" Padding="5,0"/>
                        </Grid>
                        <StackPanel x:Name="DebugPanel" Visibility="Collapsed">
                            <CheckBox x:Name="Verbose" Margin="5,5,0,5" Visibility="Collapsed">
                                <CheckBox.Content><TextBlock>
                                    <Run Text="详细日志 (--verbose)"/>
                                    <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                                </TextBlock></CheckBox.Content>
                            </CheckBox>
                            <TextBlock x:Name="LogFileLabel" Margin="5,5,0,5" Visibility="Collapsed">
                                <Run Text="日志文件 --log-file"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <Grid Margin="5,0,5,8" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="LogFile" Height="28" Visibility="Collapsed"/>
                                <Button x:Name="LogFileBrowse" Grid.Column="1" Content="浏览..." Margin="5,0,0,0" Click="BrowseLogFilePath_Click" Visibility="Collapsed"/>
                            </Grid>
                            <CheckBox x:Name="NoPerf" Margin="5,5,0,5" Visibility="Collapsed">
                                <CheckBox.Content><TextBlock>
                                    <Run Text="关闭性能计时 (--no-perf)"/>
                                    <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                                </TextBlock></CheckBox.Content>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- 右侧：命令行预览 -->
        <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="4" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="命令行预览" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,5"/>
                    <!-- 外观设置：文字/背景颜色、字号、行距，与日志面板共用同一份设置 -->
                    <Button x:Name="PreviewAppearanceButton" Grid.Column="1" Content="🎨" Width="26" Height="20" FontSize="11"
                            Margin="0,0,0,5" Click="PreviewAppearanceButton_Click" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" ToolTip="调整文字颜色/字号/行距"/>
                    <Popup x:Name="PreviewAppearancePopup" PlacementTarget="{Binding ElementName=PreviewAppearanceButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <controls:AppearancePanel/>
                    </Popup>
                </Grid>
                <TextBox x:Name="CommandPreview" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                         Background="#2D2D2D" Foreground="#00FF41" FontFamily="Consolas" FontSize="13"
                         BorderThickness="0" MinHeight="150" VerticalScrollBarVisibility="Auto"/>

                <!-- 配置导入导出：复制命令行给别人，粘贴回来自动解析成表单 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="复制配置" Click="CopyConfig_Click" Height="26" Padding="8,0"
                            ToolTip="把当前配置（命令行）复制到剪贴板，可发给别人或存到别处"/>
                    <Button Content="导入配置" Click="ImportConfig_Click" Height="26" Padding="8,0" Margin="8,0,0,0"
                            ToolTip="从剪贴板解析配置（命令行或 ini 内容）填入表单，会覆盖当前内容"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- ContextMenu 定义 -->
    <UserControl.Resources>
        <ContextMenu x:Key="BasicMenu"/>
        <ContextMenu x:Key="PerfMenu"/>
        <ContextMenu x:Key="GpuMenu"/>
        <ContextMenu x:Key="ContextMenu"/>
        <ContextMenu x:Key="InferenceMenu"/>
        <ContextMenu x:Key="ApiMenu"/>
        <ContextMenu x:Key="ModeMenu"/>
        <ContextMenu x:Key="AdvancedMenu"/>
        <ContextMenu x:Key="DebugMenu"/>
    </UserControl.Resources>
</UserControl>
