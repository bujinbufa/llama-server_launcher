<UserControl x:Class="LlamaManager.Views.Controls.ConfigForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LlamaManager.Views.Controls"
             FontSize="14">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- 搜索按钮：左侧中间位置 -->
        <Button x:Name="SearchButton" Grid.Column="0" Content="🔍" Width="30" Height="30"
                VerticalAlignment="Center" Margin="0,0,5,0" Click="SearchButton_Click" ToolTip="搜索参数并定位"/>
        <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchButton}" Placement="Right"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Width="170" Height="26" KeyDown="SearchBox_KeyDown"/>
                        <Button Grid.Column="1" Content="定位" Height="26" Padding="8,0" Margin="5,0,0,0" Click="SearchLocate_Click"/>
                    </Grid>
                    <TextBlock x:Name="SearchStatus" FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 左侧：参数表单 -->
        <ScrollViewer x:Name="FormScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" Margin="0,0,10,0">
            <StackPanel>

        <!-- 顶部：配置名称 + 重置按钮 -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ConfigNameLabel" Text="配置名称（必填）" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="重置" Height="24" Padding="8,0" Click="ClearAllFields_Click"/>
        </Grid>
        <TextBox x:Name="ConfigName" Height="28" Margin="0,0,0,15"/>

        <!-- ==================== 基础设置 ==================== -->
        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <Grid Background="#F0F0F0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="基础设置" FontWeight="Bold" VerticalAlignment="Center" Margin="5,5,5,5"/>
                    <Button Grid.Column="2" Content="清空" Click="ClearGroup_Click" Tag="Basic" Height="22" Padding="8,0" Margin="0,0,5,0"/>
                </Grid>
                <TextBlock x:Name="ServerPathLabel" Margin="0,0,0,5">
                    <Run Text="llama-server 路径（必填）"/>
                    <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                </TextBlock>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ServerPath" Height="28"/>
                    <Button Grid.Column="1" Content="浏览..." Margin="5,0,0,0" Click="BrowseServerPath_Click"/>
                </Grid>

                <TextBlock x:Name="ModelPathLabel" Margin="0,0,0,5">
                    <Run Text="模型文件 --model（必填）"/>
                    <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                </TextBlock>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ModelPath" Height="28"/>
                    <Button Grid.Column="1" Content="浏览..." Margin="5,0,0,0" Click="BrowseModelPath_Click"/>
                </Grid>

                <!-- 多模态投影文件（常驻显示，纯文本模型留空即可） -->
                <TextBlock x:Name="MmprojPathLabel" Margin="0,0,0,5">
                    <Run Text="多模态投影文件 --mmproj（视觉）"/>
                    <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                </TextBlock>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MmprojPath" Height="28"/>
                    <Button x:Name="MmprojPathBrowse" Grid.Column="1" Content="浏览..." Margin="5,0,0,0" Click="BrowseMmprojPath_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 性能调整 ==================== -->
        <GroupBox Header="性能调整" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <!-- 性能参数子块 -->
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="3" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Background="#F0F0F0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="性能参数" FontWeight="Bold" VerticalAlignment="Center" Margin="5,5,5,5"/>
                            <Button Grid.Column="2" Content="清空" Click="ClearGroup_Click" Tag="Performance,GPU" Height="22" Padding="8,0" Margin="0,0,5,0"/>
                            <Button Grid.Column="3" Content="隐藏/显示" Click="TogglePanel_Click" Tag="PerfPanel" Margin="0,0,5,0" Height="22" Padding="5,0"/>
                            <Button Grid.Column="1" HorizontalAlignment="Right" Content="添加参数" Click="AddParamButton_Click" Tag="PerfMenu" Margin="0,0,5,0" Height="22" Padding="5,0"/>
                        </Grid>
                        <StackPanel x:Name="PerfPanel">
                            <TextBlock x:Name="GpuLayersLabel" Margin="5,5,0,5">
                                <Run Text="GPU 层数 --gpu-layers"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <TextBox x:Name="GpuLayers" Height="28" Margin="5,0,5,8"/>

                            <TextBlock x:Name="ThreadsLabel" Margin="5,5,0,5">
                                <Run Text="线程数 --threads"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <TextBox x:Name="Threads" Height="28" Margin="5,0,5,8"/>

                            <TextBlock x:Name="BatchSizeLabel" Margin="5,5,0,5">
                                <Run Text="批处理大小 --batch-size"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <TextBox x:Name="BatchSize" Height="28" Margin="5,0,5,8"/>

                            <TextBlock x:Name="UBatchSizeLabel" Margin="5,5,0,5" Visibility="Collapsed">
                                <Run Text="物理批处理 --ubatch-size"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <TextBox x:Name="UBatchSize" Height="28" Margin="5,0,5,8" Visibility="Collapsed"/>

                            <TextBlock x:Name="FlashAttnLabel" Margin="5,5,0,5" Visibility="Collapsed">
                                <Run Text="Flash Attention --flash-attn"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <ComboBox x:Name="FlashAttn" Height="28" Margin="5,0,5,8" Visibility="Collapsed">
                                <ComboBoxItem Content=""/><ComboBoxItem Content="on"/>
                                <ComboBoxItem Content="off"/><ComboBoxItem Content="auto"/>
                            </ComboBox>

                            <TextBlock x:Name="CacheTypeKLabel" Margin="5,5,0,5" Visibility="Collapsed">
                                <Run Text="K 缓存精度 --cache-type-k"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <ComboBox x:Name="CacheTypeK" Height="28" Margin="5,0,5,8" Visibility="Collapsed">
                                <ComboBoxItem Content=""/>
                                <ComboBoxItem Content="f32"/><ComboBoxItem Content="f16"/><ComboBoxItem Content="bf16"/>
                                <ComboBoxItem Content="q8_0"/><ComboBoxItem Content="q4_0"/><ComboBoxItem Content="q4_1"/>
                                <ComboBoxItem Content="iq4_nl"/><ComboBoxItem Content="q5_0"/><ComboBoxItem Content="q5_1"/>
                            </ComboBox>

                            <TextBlock x:Name="CacheTypeVLabel" Margin="5,5,0,5" Visibility="Collapsed">
                                <Run Text="V 缓存精度 --cache-type-v"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <ComboBox x:Name="CacheTypeV" Height="28" Margin="5,0,5,8" Visibility="Collapsed">
                                <ComboBoxItem Content=""/>
                                <ComboBoxItem Content="f32"/><ComboBoxItem Content="f16"/><ComboBoxItem Content="bf16"/>
                                <ComboBoxItem Content="q8_0"/><ComboBoxItem Content="q4_0"/><ComboBoxItem Content="q4_1"/>
                                <ComboBoxItem Content="iq4_nl"/><ComboBoxItem Content="q5_0"/><ComboBoxItem Content="q5_1"/>
                            </ComboBox>

                            <CheckBox x:Name="Mlock" Margin="5,5,0,5" Visibility="Collapsed">
                                <CheckBox.Content><TextBlock>
                                    <Run Text="锁定内存 (--mlock)"/>
                                    <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                                </TextBlock></CheckBox.Content>
                            </CheckBox>

                            <CheckBox x:Name="NoMmap" Margin="5,5,0,5" Visibility="Collapsed">
                                <CheckBox.Content><TextBlock>
                                    <Run Text="禁用内存映射 (--no-mmap)"/>
                                    <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                                </TextBlock></CheckBox.Content>
                            </CheckBox>

                            <!-- 加载模式 -->
                            <TextBlock x:Name="LoadModeLabel" Margin="5,5,0,5" Visibility="Collapsed">
                                <Run Text="加载模式 --load-mode"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <ComboBox x:Name="LoadMode" Height="28" Margin="5,0,5,8" Visibility="Collapsed">
                                <ComboBoxItem Content=""/><ComboBoxItem Content="auto"/>
                                <ComboBoxItem Content="none"/><ComboBoxItem Content="mmap"/>
                                <ComboBoxItem Content="mlock"/><ComboBoxItem Content="mmap+mlock"/>
                                <ComboBoxItem Content="dio"/>
                            </ComboBox>

                            <!-- 批处理线程 -->
                            <TextBlock x:Name="ThreadsBatchLabel" Margin="5,5,0,5" Visibility="Collapsed">
                                <Run Text="批处理线程 --threads-batch"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <TextBox x:Name="ThreadsBatch" Height="28" Margin="5,0,5,8" Visibility="Collapsed"/>

                            <CheckBox x:Name="NoKvOffload" Margin="5,5,0,5" Visibility="Collapsed">
                                <CheckBox.Content><TextBlock>
                                    <Run Text="KV 缓存放内存 (--no-kv-offload)"/>
                                    <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                                </TextBlock></CheckBox.Content>
                            </CheckBox>

                            <CheckBox x:Name="NoWarmup" Margin="5,5,0,5" Visibility="Collapsed">
                                <CheckBox.Content><TextBlock>
                                    <Run Text="跳过预热 (--no-warmup)"/>
                                    <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                                </TextBlock></CheckBox.Content>
                            </CheckBox>

                            <!-- MoE CPU 层数 -->
                            <TextBlock x:Name="NCpuMoeLabel" Margin="5,5,0,5" Visibility="Collapsed">
                                <Run Text="MoE CPU 层数 --n-cpu-moe"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <TextBox x:Name="NCpuMoe" Height="28" Margin="5,0,5,8" Visibility="Collapsed"/>

                            <!-- NUMA 优化 -->
                            <TextBlock x:Name="NumaLabel" Margin="5,5,0,5" Visibility="Collapsed">
                                <Run Text="NUMA 优化 --numa"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <ComboBox x:Name="Numa" Height="28" Margin="5,0,5,8" Visibility="Collapsed">
                                <ComboBoxItem Content=""/><ComboBoxItem Content="distribute"/>
                                <ComboBoxItem Content="isolate"/><ComboBoxItem Content="numactl"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- GPU 多卡子块 -->
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="3">
                    <StackPanel>
                        <Grid Background="#F0F0F0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GPU 多卡" FontWeight="Bold" VerticalAlignment="Center" Margin="5,5,5,5"/>
                            <Button Grid.Column="2" Content="清空" Click="ClearGroup_Click" Tag="GPU" Height="22" Padding="8,0" Margin="0,0,5,0"/>
                            <Button Grid.Column="3" Content="隐藏/显示" Click="TogglePanel_Click" Tag="GpuPanel" Margin="0,0,5,0" Height="22" Padding="5,0"/>
                            <Button Grid.Column="1" HorizontalAlignment="Right" Content="添加参数" Click="AddParamButton_Click" Tag="GpuMenu" Margin="0,0,5,0" Height="22" Padding="5,0"/>
                        </Grid>
                        <StackPanel x:Name="GpuPanel" Visibility="Collapsed">
                            <TextBlock x:Name="MainGpuLabel" Margin="5,5,0,5" Visibility="Collapsed">
                                <Run Text="主 GPU 索引 --main-gpu"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <TextBox x:Name="MainGpu" Height="28" Margin="5,0,5,8" Visibility="Collapsed"/>

                            <TextBlock x:Name="TensorSplitLabel" Margin="5,5,0,5" Visibility="Collapsed">
                                <Run Text="张量分配 --tensor-split"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <TextBox x:Name="TensorSplit" Height="28" Margin="5,0,5,8" Visibility="Collapsed"/>

                            <TextBlock x:Name="SplitModeLabel" Margin="5,5,0,5" Visibility="Collapsed">
                                <Run Text="拆分模式 --split-mode"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <ComboBox x:Name="SplitMode" Height="28" Margin="5,0,5,8" Visibility="Collapsed">
                                <ComboBoxItem Content=""/><ComboBoxItem Content="none"/>
                                <ComboBoxItem Content="layer"/><ComboBoxItem Content="row"/>
                                <ComboBoxItem Content="tensor"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </GroupBox>

        <!-- ==================== 上下文参数 ==================== -->
        <GroupBox Header="上下文参数" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="3">
                    <StackPanel>
                        <Grid Background="#F0F0F0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="上下文参数" FontWeight="Bold" VerticalAlignment="Center" Margin="5,5,5,5"/>
                            <Button Grid.Column="2" Content="清空" Click="ClearGroup_Click" Tag="Context" Height="22" Padding="8,0" Margin="0,0,5,0"/>
                            <Button Grid.Column="3" Content="隐藏/显示" Click="TogglePanel_Click" Tag="ContextPanel" Margin="0,0,5,0" Height="22" Padding="5,0"/>
                            <Button Grid.Column="1" HorizontalAlignment="Right" Content="添加参数" Click="AddParamButton_Click" Tag="ContextMenu" Margin="0,0,5,0" Height="22" Padding="5,0"/>
                        </Grid>
                        <StackPanel x:Name="ContextPanel">
                            <TextBlock x:Name="ContextLabel" Margin="5,5,0,5">
                                <Run Text="上下文长度 --ctx-size"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <TextBox x:Name="Context" Height="28" Margin="5,0,5,8"/>

                            <TextBlock x:Name="ParallelLabel" Margin="5,5,0,5">
                                <Run Text="并行序列数 --parallel"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <TextBox x:Name="Parallel" Height="28" Margin="5,0,5,8"/>

                            <!-- 缓存复用 -->
                            <TextBlock x:Name="CacheReuseLabel" Margin="5,5,0,5" Visibility="Collapsed">
                                <Run Text="缓存复用 --cache-reuse"/>
                                <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                            </TextBlock>
                            <TextBox x:Name="CacheReuse" Height="28" Margin="5,0,5,8" Visibility="Collapsed"/>

                            <CheckBox x:Name="CtxShift" Margin="5,5,0,5" Visibility="Collapsed">
                                <CheckBox.Content><TextBlock>
                                    <Run Text="上下文移位 (--context-shift)"/>
                                    <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
                                </TextBlock></CheckBox.Content>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </GroupBox>

        <!-- ==================== 推理设置 ==================== -->
        <GroupBox Header="推理设置" Padding="10" Margin="0,0,0,15">
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="3">
                <StackPanel>
                    <Grid Background="#F0F0F0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="推理参数" FontWeight="Bold" VerticalAlignment="Center" Margin="5,5,5,5"/>
                        <Button Grid.Column="2" Content="清空" Click="ClearGroup_Click" Tag="Inference" Height="22" Padding="8,0" Margin="0,0,5,0"/>
                        <Button Grid.Column="3" Content="隐藏/显示" Click="TogglePanel_Click" Tag="InferencePanel" Margin="0,0,5,0" Height="22" Padding="5,0"/>
                        <Button Grid.Column="1" HorizontalAlignment="Right" Content="添加参数" Click="AddParamButton_Click" Tag="InferenceMenu" Margin="0,0,5,0" Height="22" Padding="5,0"/>
                    </Grid>

                    <!-- 采样预设：独立功能，可自定义添加多个，不受清空/重置影响 -->
                    <Grid Margin="5,6,5,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="预设" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="PresetCombo" Grid.Column="1" Height="26" SelectionChanged="PresetCombo_SelectionChanged"
                                  DropDownOpened="PresetCombo_DropDownOpened" DropDownClosed="PresetCombo_DropDownClosed" ToolTip="选择预设自动应用"/>
                        <TextBox x:Name="PresetNameBox" Grid.Column="2" Width="100" Height="26" Margin="5,0,0,0" ToolTip="新预设名称"/>
                        <Button Grid.Column="3" Content="存为预设" Height="26" Padding="8,0" Margin="5,0,0,0" Click="SavePreset_Click" ToolTip="把当前推理参数保存为预设"/>
                        <Button Grid.Column="4" Content="删除" Height="26" Padding="8,0" Margin="5,0,0,0" Click="DeletePreset_Click" ToolTip="删除选中的预设"/>
                    </Grid>

                    <StackPanel x:Name="InferencePanel">

                        <!-- 温度 -->
                        <StackPanel x:Name="TemperatureLabel" Orientation="Horizontal" Margin="5,5,0,5" Visibility="Collapsed">
    <CheckBox x:Name="TemperatureEnabled" VerticalAlignment="Center" Margin="0,0,6,0" Checked="InferenceParam_Toggled" Unchecked="InferenceParam_Toggled"/>
    <TextBlock>
<Run Text="温度 --temperature"/>
                            <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
    </TextBlock>
</StackPanel>
                        <Grid Margin="5,0,5,8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Slider x:Name="Temperature" Minimum="0" Maximum="2" Value="0.8" TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TemperatureValue" Text="0.8" Margin="10,0,0,0" VerticalAlignment="Center" Width="35" TextAlignment="Right"/>
                        </Grid>

                        <!-- Top-P -->
                        <StackPanel x:Name="TopPLabel" Orientation="Horizontal" Margin="5,5,0,5" Visibility="Collapsed">
    <CheckBox x:Name="TopPEnabled" VerticalAlignment="Center" Margin="0,0,6,0" Checked="InferenceParam_Toggled" Unchecked="InferenceParam_Toggled"/>
    <TextBlock>
<Run Text="Top-P 核采样 --top-p"/>
                            <Hyperlink Click="HelpLink_Click" Foreground="Red" FontWeight="Bold" FontSize="15" Cursor="Hand" TextDecorations="{x:Null}"><Run Text="?"/></Hyperlink>
    </TextBlock>
</StackPanel>
                        <Grid Margin="5,0,5,8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Slider x:Name="TopP" Minimum="0" Maximum="1" Value="0.95" TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
