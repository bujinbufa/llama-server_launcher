<Window x:Class="LlamaManager.Views.ChatTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="测试对话" Width="760" Height="820" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 连接信息 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="API" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="UrlBox" Grid.Column="1" Height="26" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="密钥" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <TextBox x:Name="KeyBox" Grid.Column="3" Height="26" VerticalContentAlignment="Center"
                     ToolTip="可选，对应 --api-key"/>
        </Grid>

        <!-- 预设选择 + 覆盖控制：选预设只填滑块值（待确认），点应用覆盖才真正生效 -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="采样预设" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="PresetCombo" Grid.Column="1" Height="26"
                      SelectionChanged="PresetCombo_SelectionChanged"
                      DropDownOpened="PresetCombo_DropDownOpened"
                      DropDownClosed="PresetCombo_DropDownClosed"
                      ToolTip="复用配置界面的采样预设；选中后填入滑块，需点应用覆盖才生效"/>
            <Button x:Name="ApplyOverrideButton" Grid.Column="2" Content="应用覆盖" Height="26" Padding="10,0"
                    Margin="10,0,0,0" Click="ApplyOverride_Click"
                    ToolTip="确认后，之后每次发送都按已勾选参数的滑块值请求（覆盖启动配置）"/>
            <Button Grid.Column="3" Content="恢复启动配置" Height="26" Padding="10,0"
                    Margin="8,0,0,0" Click="RestoreStartup_Click"
                    ToolTip="取消全部勾选，滑块弹回启动配置值，完全跟随启动配置"/>
        </Grid>

        <!-- 采样调参板：勾选框决定哪些参数启用覆盖；滑块映射启动配置基准值 -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="LightGray" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,8,0,8">
            <StackPanel>
                <TextBlock x:Name="OverrideStatus" Text="● 使用启动配置（勾选参数并调整滑块，点“应用覆盖”才生效）"
                           FontSize="12" Foreground="Gray" Margin="0,0,0,6"/>

                <!-- 采样滑块行由代码从 ConfigCommon 字典自动生成（收录条件：Inference 组 + Slider 类型 + 填了 LockField）；
                     加/删参数只改 ConfigCommon.cs 字典，此处无需改动 -->
                <StackPanel x:Name="ParamPanel"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="MaxTokEnabled" VerticalAlignment="Center" Checked="ParamEnabled_Changed" Unchecked="ParamEnabled_Changed"
                                  ToolTip="勾选后最大Token才生效；不勾 = 不限长度"/>
                        <Button Content="?" Width="16" Height="16" Padding="0" Margin="4,0,0,0" FontSize="11"
                                Foreground="Red" Click="ParamHelp_Click"
                                ToolTip="点击查看参数说明"/>
                    </StackPanel>
                    <TextBlock x:Name="MaxTokBase" Grid.Column="1" Text="最大Token（启动：--）" VerticalAlignment="Center"/>
                    <TextBox x:Name="MaxTokBox" Grid.Column="2" Height="24" VerticalContentAlignment="Center"
                             ToolTip="max_tokens：勾选并填写后限制回复长度"/>
                </Grid>
                <TextBlock x:Name="MaxTokDesc" Grid.ColumnSpan="4" Visibility="Collapsed" TextWrapping="Wrap"
                           FontSize="12" Foreground="Gray" Margin="44,0,0,4"
                           Text="单次回复的最大长度；不影响风格，只管长短。勾选并填写后生效，不勾 = 不限制"/>
            </StackPanel>
        </Border>

        <!-- 对话记录 -->
        <TextBox x:Name="ChatView" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
                 Background="#2D2D2D" Foreground="#00FF41" FontFamily="Consolas" FontSize="14" Block.LineHeight="22"
                 Padding="6" BorderThickness="0" VerticalScrollBarVisibility="Auto"/>

        <!-- 输入区 -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" KeyDown="InputBox_KeyDown"
                     ToolTip="回车发送，Shift+回车换行"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="发送" Width="70" Height="60" Margin="8,0,0,0" Click="SendButton_Click"/>
            <Button x:Name="StopButton" Grid.Column="2" Content="停止" Width="56" Height="60" Margin="8,0,0,0" Click="StopButton_Click" IsEnabled="False"/>
            <Button Grid.Column="3" Content="清空" Width="56" Height="60" Margin="8,0,0,0" Click="ClearButton_Click" ToolTip="清空对话记录与上下文"/>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="5" FontSize="12" Foreground="Gray" Margin="0,6,0,0" Text="提示：默认跟随启动配置；勾选参数 → 调整滑块 → 点“应用覆盖”生效"/>
    </Grid>
</Window>
